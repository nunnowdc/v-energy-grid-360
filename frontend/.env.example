# Perfil do usuário de teste, usado enquanto o login não existe.
# Copie este arquivo para .env.local e troque o valor para testar cada perfil:
# DIRETORIA | ATENDIMENTO | PERDAS | OPERACAO | ADMIN_TI
VITE_PERFIL_TESTE=ADMIN_TI

# Dados de exemplo (MSW) para as rotas que o backend ainda não tem.
# Só funcionam no npm run dev. Use false quando o backend tiver as rotas
VITE_USAR_DADOS_EXEMPLO=true
