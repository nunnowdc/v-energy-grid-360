# Copie para .env.local e ajuste os valores para sua instalação local.
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Defina um segredo local persistente para assinar JWTs de 15 minutos.
JWT_SECRET_KEY=

DATABASE_URL=postgresql+psycopg://postgres:SUA_SENHA@localhost:5433/BANCO

# Bootstrap manual da primeira conta ADMIN_TI. Informe a senha no ambiente
# somente durante a execução; não grave um valor neste arquivo nem no Git.
# A senha deve ter no mínimo 8 caracteres
BOOTSTRAP_ADMIN_PASSWORD=

# Agente de IA. O OpenRouter é tentado primeiro e o 9router fica de reserva;
# o provedor com a chave vazia é pulado. Sem nenhuma chave, o agente responde
# em modo de teste. Cada provedor usa o próprio nome de modelo
OPENROUTER_API_KEY=
MODELO_LLM_PRIMARIO=

NINEROUTER_API_KEY=
NINEROUTER_BASE_URL=http://localhost:20128/v1/chat/completions
MODELO_LLM_FALLBACK=
