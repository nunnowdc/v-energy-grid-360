# Copie para .env.local e ajuste os valores para sua instalação local.
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Defina um segredo local persistente para assinar JWTs de 15 minutos.
JWT_SECRET_KEY=

DATABASE_URL=postgresql+psycopg://postgres:SUA_SENHA@localhost:5433/BANCO

# Permissões no banco (opcional). Com USE_DB_ROLES=false (padrão) o backend usa
# só a DATABASE_URL, como hoje. Com true (valor inválido faz a config falhar):
# - PORTAL_APP_DATABASE_URL: usuário portal_app; cada transação roda
#   SET LOCAL ROLE perfil_<perfil> conforme a conta logada (rotas de negócio)
# - PORTAL_AUTH_DATABASE_URL: usuário portal_auth; só login, conta atual e troca
#   de senha, onde o perfil ainda não é conhecido
# A DATABASE_URL (dono) continua em uso só nos scripts administrativos.
USE_DB_ROLES=false
PORTAL_APP_DATABASE_URL=postgresql+psycopg://portal_app:SUA_SENHA@localhost:5433/BANCO
PORTAL_AUTH_DATABASE_URL=postgresql+psycopg://portal_auth:SUA_SENHA@localhost:5433/BANCO

# Bootstrap manual da primeira conta ADMIN_TI. Informe a senha no ambiente
# somente durante a execução; não grave um valor neste arquivo nem no Git.
# A senha deve ter no mínimo 8 caracteres
BOOTSTRAP_ADMIN_PASSWORD=

# Agente de IA. O OpenRouter é tentado primeiro e o 9router fica de reserva;
# o provedor com a chave vazia é pulado. Sem nenhuma chave, o agente responde
# em modo de teste. Cada provedor usa o próprio nome de modelo
OPENROUTER_API_KEY=
MODELO_LLM_PRIMARIO=

NINEROUTER_API_KEY=
NINEROUTER_BASE_URL=http://localhost:20128/v1/chat/completions
MODELO_LLM_FALLBACK=
